diff --git a/termux-app/app/src/main/java/com/termux/dshweb/DshWebOverlay.java b/app/src/main/java/com/termux/dshweb/DshWebOverlay.java
new file mode 100644
index 0000000..da4e36b
--- /dev/null
+++ b/termux-app/app/src/main/java/com/termux/dshweb/DshWebOverlay.java
@@ -0,0 +1,125 @@
+package com.termux.dshweb;
+
+import android.annotation.SuppressLint;
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.view.View;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+
+/**
+ * Swaps the terminal for the DSH web UI as soon as the server is up.
+ *
+ * Termux's bootstrap second stage runs `~/.bashrc`, which starts `dsh web` on
+ * 127.0.0.1:3080 and writes the authenticated URL (it carries a per-process
+ * token) to `$HOME/.dsh-web-url`. This overlay waits for that file, then loads
+ * it into a WebView so the app is usable the moment it is opened. Long-press
+ * the floating button (or tap the WebView's overflow) to go back to the terminal.
+ */
+public final class DshWebOverlay {
+
+    private static final String LOG_TAG = "DshWebOverlay";
+    private static final int DSH_PORT = 3080;
+    private static final long POLL_INTERVAL_MS = 500;
+    private static final long POLL_TIMEOUT_MS = 600000;
+
+    private final Activity activity;
+    private final View webView;
+    private final View terminalView;
+    private final View toggleButton;
+    private final File urlFile;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final long startedAt = System.currentTimeMillis();
+    private String loadedUrl;
+    private boolean stopped;
+
+    public DshWebOverlay(Activity activity, WebView webView, View terminalView, View toggleButton) {
+        this.activity = activity;
+        this.webView = webView;
+        this.terminalView = terminalView;
+        this.toggleButton = toggleButton;
+        this.urlFile = new File(activity.getFilesDir().getParentFile(), "home/.dsh-web-url");
+        configure(webView);
+        toggleButton.setOnClickListener(v -> showTerminal());
+    }
+
+    @SuppressLint("SetJavaScriptEnabled")
+    private void configure(WebView view) {
+        view.getSettings().setJavaScriptEnabled(true);
+        view.getSettings().setDomStorageEnabled(true);
+        view.getSettings().setAllowFileAccess(false);
+        view.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView v, WebResourceRequest request) {
+                Uri uri = request.getUrl();
+                String host = uri.getHost();
+                if (host != null && (host.equals("127.0.0.1") || host.equals("localhost"))) return false;
+                try {
+                    v.getContext().startActivity(new Intent(Intent.ACTION_VIEW, uri));
+                } catch (Exception e) {
+                    Log.w(LOG_TAG, "no activity handles " + uri, e);
+                }
+                return true;
+            }
+        });
+    }
+
+    public void start() {
+        handler.post(poll);
+    }
+
+    public void stop() {
+        stopped = true;
+        handler.removeCallbacks(poll);
+    }
+
+    private final Runnable poll = new Runnable() {
+        @Override
+        public void run() {
+            if (stopped) return;
+            String url = readUrl();
+            if (url != null && !url.equals(loadedUrl)) {
+                loadedUrl = url;
+                showWeb();
+                ((WebView) webView).loadUrl(url);
+                return;
+            }
+            if (System.currentTimeMillis() - startedAt < POLL_TIMEOUT_MS) {
+                handler.postDelayed(this, POLL_INTERVAL_MS);
+            }
+        }
+    };
+
+    /** The URL file is rewritten by every shell start; an empty or absent file means "not yet". */
+    private String readUrl() {
+        if (!urlFile.isFile()) return null;
+        try {
+            String text = new String(Files.readAllBytes(urlFile.toPath()), StandardCharsets.UTF_8).trim();
+            return text.startsWith("http") ? text : null;
+        } catch (IOException e) {
+            return null;
+        }
+    }
+
+    private void showWeb() {
+        terminalView.setVisibility(View.GONE);
+        webView.setVisibility(View.VISIBLE);
+        toggleButton.setVisibility(View.VISIBLE);
+    }
+
+    private void showTerminal() {
+        webView.setVisibility(View.GONE);
+        terminalView.setVisibility(View.VISIBLE);
+        toggleButton.setVisibility(View.VISIBLE);
+    }
+}
