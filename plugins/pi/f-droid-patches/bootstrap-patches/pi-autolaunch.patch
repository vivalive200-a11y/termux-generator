diff --git a/packages/bash/etc-bash.bashrc b/packages/bash/etc-bash.bashrc
index c1f4780..1a1d0df 100644
--- a/packages/bash/etc-bash.bashrc
+++ b/packages/bash/etc-bash.bashrc
@@ -32,3 +32,26 @@ if [[ -r "@TERMUX_PREFIX@/share/bash-completion/bash_completion" ]]; then
 	. "@TERMUX_PREFIX@/share/bash-completion/bash_completion"
 fi
 # vim: set noet ft=bash tw=4 sw=4 ff=unix
+
+# --- termux-generator plugin "pi": auto-install and launch the pi coding agent ---
+if [ -t 1 ] && [ -z "${PI_AUTOLAUNCHED:-}" ] && [ ! -f "${HOME:-/nonexistent}/.no-pi-autolaunch" ]; then
+	export PI_AUTOLAUNCHED=1
+	PI_CLI="$PREFIX/lib/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"
+	if [ ! -f "$PI_CLI" ]; then
+		command -v npm > /dev/null 2>&1 || { echo "[pi] Installing npm (needs network) ..."; pkg install -y npm; }
+		if command -v npm > /dev/null 2>&1; then
+			echo "[pi] Installing the pi coding agent (needs network) ..."
+			npm install -g --ignore-scripts @earendil-works/pi-coding-agent
+		fi
+	fi
+	if [ -f "$PI_CLI" ]; then
+		if [ -e "$PREFIX/bin/pi" ] && head -1 "$PREFIX/bin/pi" 2>/dev/null | grep -q /usr/bin/env; then
+			rm -f "$PREFIX/bin/pi"
+			printf '#!%s/bin/sh\nexec %s/bin/node "%s" "$@"\n' "$PREFIX" "$PREFIX" "$PI_CLI" > "$PREFIX/bin/pi"
+			chmod 755 "$PREFIX/bin/pi"
+		fi
+		node "$PI_CLI"
+	else
+		echo "[pi] pi not installed. Try: pkg install npm && npm install -g @earendil-works/pi-coding-agent"
+	fi
+fi
\ No newline at end of file
